        </mxCell>
        <mxCell id="card-legend-notes" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Large dashed frame: infra perimeter · small: functional group&lt;br&gt;&lt;font color=&quot;#c2410c&quot;&gt;&lt;b&gt;⚠ Gx&lt;/b&gt;&lt;/font&gt;: docs and code disagree, see &quot;Gaps&quot;&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10.5;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="1440" width="440" height="40" as="geometry" />
        </mxCell>
        <mxCell id="card-data-plane" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#0891b2&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;Achat · data plane&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;1&lt;/span&gt; L’acheteur poste sa commande au load balancer régional.&lt;br&gt;&lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;2&lt;/span&gt; Le LB choisit un nginx sain (health check /readyz).&lt;br&gt;&lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;3&lt;/span&gt; nginx relaie vers app-01 ou app-02 : son upstream contient les deux.&lt;br&gt;&lt;span style=&quot;background-color:#0f172a;color:#ffffff;border-radius:3px;padding:0px 4px;font-weight:bold;&quot;&gt;4&lt;/span&gt; Transaction SQL sur la primaire, jointe par db-primary.p2.genarchi.internal.&lt;br&gt;• web-02 et app-02 (DC 2) suivent le même chemin. L’app est sans état.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="550" y="1240" width="600" height="250" as="geometry" />
        </mxCell>
        <mxCell id="card-control-plane" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#7c3aed&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;Arrière-plan · control plane&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;span style=&quot;border:1px solid #0f172a;color:#0f172a;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;A&lt;/span&gt; &lt;span style=&quot;border:1px solid #0f172a;color:#0f172a;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;B&lt;/span&gt; batch-01 émet les QR toutes les 15 min, lance pg_dump à 02:00 et l’export CSV à 03:00.&lt;br&gt;&lt;span style=&quot;border:1px solid #0f172a;color:#0f172a;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;C&lt;/span&gt; db-02 ouvre la réplication asynchrone vers db-01.&lt;br&gt;&lt;span style=&quot;border:1px solid #0f172a;color:#0f172a;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;D&lt;/span&gt; Zabbix poste ses alertes sur un webhook Discord, via Cloud NAT.&lt;br&gt;&lt;span style=&quot;border:1px solid #0f172a;color:#0f172a;border-radius:3px;padding:0px 3px;font-weight:bold;&quot;&gt;E&lt;/span&gt; L’opérateur rejoint le bastion par un tunnel IAP, puis rebondit en SSH.&lt;br&gt;• Non dessinés : agents Zabbix (10050) sur chaque VM, rebond SSH vers toutes les VM, snapshots quotidiens des disques db et nfs.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1180" y="1240" width="640" height="250" as="geometry" />
        </mxCell>
        <mxCell id="card-pannes" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#ea580c&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:13px&quot;&gt;Pannes et reprise&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;web ou app perdu&lt;/font&gt;&lt;/b&gt; : retiré du LB en ~10 s, relance manuelle.&lt;br&gt;• &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;db-01 perdu&lt;/font&gt;&lt;/b&gt; : runbook (fencing, promotion de db-02, DNS repointé). Cibles RTO ≤ 30 min, RPO ≤ 5 min.&lt;br&gt;• &lt;b&gt;&lt;font color=&quot;#0f172a&quot;&gt;Zone a perdue&lt;/font&gt;&lt;/b&gt; : runbook DR manuel, db-02 promue, nfs recréé depuis snapshot.&lt;br&gt;• SPOF assumés : nfs-01, batch-01, mon-01.&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#c2410c&quot;&gt;À confirmer au coaching&lt;/font&gt;&lt;/b&gt; GCP, deux zones avec bascule manuelle, cibles RTO/RPO.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1850" y="1240" width="590" height="250" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
