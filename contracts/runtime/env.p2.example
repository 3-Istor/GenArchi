# Platform 2 — /etc/genarchi/genarchi.env (écrit par Ansible, rôle app ; mode 0600, propriétaire root)
# Les <secret> sont générés par OpenTofu (infra/p2/secrets.tf) et transmis par l'inventaire Ansible.
PLATFORM=p2
PORT=8080
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://p2.genarchi.3istor.com

DATA_BACKEND=postgres
# IP virtuelle du cluster Patroni (LB interne, sonde /primary)
DATABASE_URL=postgresql://genarchi:<secret>@db.p2.genarchi.internal:5432/genarchi

# NAS monté en NFS (IP virtuelle nas.p2.genarchi.internal)
BLOB_BACKEND=fs
BLOB_FS_ROOT=/mnt/tickets

EVENTS_BACKEND=rabbitmq
AMQP_URLS=amqp://genarchi:<secret>@witness:5672/,amqp://genarchi:<secret>@mq-1:5672/,amqp://genarchi:<secret>@mq-2:5672/

ADMIN_TOKEN=<secret>
STAFF_TOKEN=<secret>
CHAOS_ENABLED=true

# Posés par Ansible à partir de l'inventaire
INSTANCE_NAME=app-1a
ZONE=europe-west9-a
APP_VERSION=v1.0.0
