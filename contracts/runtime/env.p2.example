# Platform 2 — /etc/genarchi/genarchi.env (écrit par Ansible, mode 0600, propriétaire genarchi)
# Les valeurs marquées <secret> viennent d'Ansible Vault, jamais du repo en clair.
PLATFORM=p2
PORT=8080
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://p2.genarchi.example

DATA_BACKEND=postgres
DATABASE_URL=postgresql://genarchi:<secret>@db-primary.p2.genarchi.internal:5432/genarchi

BLOB_BACKEND=fs
BLOB_FS_ROOT=/mnt/tickets

EVENTS_BACKEND=none

ADMIN_TOKEN=<secret>
STAFF_TOKEN=<secret>
CHAOS_ENABLED=false

# Posés par Ansible à partir de l'inventaire Terraform
INSTANCE_NAME=app-01
ZONE=europe-west9-a
