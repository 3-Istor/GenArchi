# Platform 3 — variables des services Cloud Run (posées par OpenTofu, infra/p3/run.tf)
# Les <secret> sont des références Secret Manager (version « latest »), jamais des valeurs en clair.
PLATFORM=p3
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://p3.genarchi.3istor.com

DATA_BACKEND=firestore
FIRESTORE_PROJECT=genarchi-p3

BLOB_BACKEND=gcs
BLOB_GCS_BUCKET=genarchi-p3-tickets

# api : none (c'est Firestore qui émet l'événement « billet créé », via Eventarc)
# worker et job issue-pending : pubsub (publie ticket.issued)
EVENTS_BACKEND=none
PUBSUB_PROJECT=genarchi-p3
PUBSUB_TOPIC_TICKET_ISSUED=ticket-issued

ADMIN_TOKEN=<secret: p3-admin-token>
STAFF_TOKEN=<secret: p3-staff-token>
CHAOS_ENABLED=true
# true dans la région visée par le test de panne : /readyz répond 503, le LB bascule
CHAOS_FORCE_UNREADY=false

REGION=europe-west1
APP_VERSION=v1.0.0
# PORT, K_SERVICE et K_REVISION sont fournis par Cloud Run
