# Platform 3 — variables du service Cloud Run (posées par Terraform)
# Les valeurs <secret> sont des références Secret Manager montées en variables, jamais des valeurs en clair.
PLATFORM=p3
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://p3.genarchi.example

DATA_BACKEND=firestore
FIRESTORE_PROJECT=genarchi-p3
FIRESTORE_DATABASE=(default)

BLOB_BACKEND=gcs
BLOB_GCS_BUCKET=genarchi-p3-tickets

EVENTS_BACKEND=pubsub
PUBSUB_PROJECT=genarchi-p3
PUBSUB_TOPIC_TICKET_PURCHASED=ticket-purchased
PUBSUB_TOPIC_TICKET_ISSUED=ticket-issued

ADMIN_TOKEN=<secret: sm://admin-token>
STAFF_TOKEN=<secret: sm://staff-token>
CHAOS_ENABLED=false

# Une valeur par région déployée
REGION=europe-west1

OTEL_SERVICE_NAME=genarchi-api
# Endpoint OTLP du collecteur (sidecar OpenTelemetry Collector sur le service Cloud Run,
# qui exporte vers Cloud Trace). Choix exact à figer dans l'ADR observabilité.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# PORT, K_SERVICE et K_REVISION sont fournis par Cloud Run
