# Copier en infra/p2/env.mk (ignoré par git) et remplir.
P2_PROJECT      ?= genarchi-p2
TF_STATE_BUCKET ?= genarchi-tfstate
# Serveur NAS qui porte le disque (le runbook de bascule le change) : nas-1 ou nas-2.
P2_NAS_ACTIVE   ?= nas-1
# Webhook Discord des alertes Zabbix (facultatif). À exporter plutôt qu'écrire ici :
#   export P2_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# Jeton Cloudflare « Zone DNS edit » sur 3istor.com :
#   export CLOUDFLARE_API_TOKEN=...
