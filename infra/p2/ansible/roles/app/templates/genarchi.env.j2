# Géré par Ansible (rôle app). Contrat d'exécution, partie C.
PLATFORM=p2
PORT=8080
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://{{ public_domain }}
DATA_BACKEND=postgres
DATABASE_URL=postgresql://{{ db_user }}:{{ secrets.app_db }}@{{ db_host }}:5432/{{ db_name }}
BLOB_BACKEND=fs
BLOB_FS_ROOT={{ tickets_mount }}
EVENTS_BACKEND=rabbitmq
AMQP_URLS={% for h in groups['rabbitmq'] %}amqp://genarchi:{{ secrets.rabbitmq_app }}@{{ h }}:5672/{{ ',' if not loop.last else '' }}{% endfor %}

ADMIN_TOKEN={{ secrets.admin_token }}
STAFF_TOKEN={{ secrets.staff_token }}
CHAOS_ENABLED={{ chaos_enabled | string | lower }}
INSTANCE_NAME={{ inventory_hostname }}
ZONE={{ gcp_zone }}
APP_VERSION={{ app_version }}
